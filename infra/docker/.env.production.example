# LoyaltyOS fresh-install production template
#
# Copy this file, replace every required placeholder, and keep the copy out of
# Git. The default stack is plain HTTP and does not require a domain or TLS:
#   cp infra/docker/.env.production.example infra/docker/.env.production
#   docker compose -f infra/docker/docker-compose.prod.yml \
#     --env-file infra/docker/.env.production up -d --build
#
# Values marked REQUIRED are validated by the API on startup. Optional
# integrations may remain blank; the core portal/admin stack still works.

# ── Database (REQUIRED) ─────────────────────────────────────────────────────
POSTGRES_USER=loyaltyos
POSTGRES_PASSWORD=replace-me-with-a-random-database-password
POSTGRES_DB=loyaltyos
# Optional host-only diagnostics ports; PostgreSQL/Redis are bound to localhost.
PORT_POSTGRES=5432
PORT_REDIS=6379

# ── Public HTTP deployment (REQUIRED for links) ────────────────────────────
# No Caddy or TLS is included. Portal and Admin use independent HTTP ports.
PORTAL_URL=http://localhost:8080/customer
CUSTOMER_HTTP_PORT=8080
ADMIN_HTTP_PORT=8081
COOKIE_SECURE=false

# SPA build path prefixes. Keep the trailing slash.
ADMIN_BASE_PATH=/admin/
CUSTOMER_BASE_PATH=/customer/

# Same-origin requests do not need CORS. Set CORS_ORIGINS to a comma-separated
# list only when browser clients are hosted on other origins.
CORS_ORIGIN=
CORS_ORIGINS=
LOG_LEVEL=info

# ── Initial admin (REQUIRED only on an empty database) ──────────────────────
# The API creates exactly one SUPER_ADMIN and one minimal Program after
# migrations. It never seeds demo members/data and never overwrites an admin.
ADMIN_DEFAULT_EMAIL=replace-me@example.invalid
ADMIN_DEFAULT_NAME=Replace Me
ADMIN_DEFAULT_PASSWORD=replace-me-with-a-strong-password

# ── Core secrets (REQUIRED) ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 64 / openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-64
API_KEY_SALT=replace-me-with-openssl-rand-hex-32
KMS_MASTER_KEY=replace-me-with-openssl-rand-hex-32
GIFTCARD_HMAC_SECRET=replace-me-with-openssl-rand-hex-32

# ── Email / SMTP (OPTIONAL integration) ────────────────────────────────────
# Leave credentials blank if email is not used. These values are consumed by
# the notification worker when a magic link or other email is sent.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
# Resend is an alternative email provider used by integrations that configure it.
RESEND_API_KEY=

# ── SMS / Push (OPTIONAL integrations) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── Coalition / Apprecio (OPTIONAL integration) ────────────────────────────
# Set all three token/base values when coalition transfers are enabled.
APPRECIO_API_BASE=https://apiv2.dcanje.mx/api
APPRECIO_PUBLIC_TOKEN=
APPRECIO_PRIVATE_TOKEN=
APPRECIO_IDENTIFIER_TYPE=email
APPRECIO_TIMEOUT_MS=10000

# ── Optional observability ─────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_SERVICE_NAME=loyaltyos-api
# WORKER_METRICS_PORT=3003
