  approvalDecisions ApprovalDecision[]

  @@index([programId])
  @@index([email])
}

enum WorkflowApprovalMode {
  ANY
  ALL
  COUNT
}

enum WorkflowSelfApprovalPolicy {
  DENY
  ALLOW
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalRequestStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
}

/// A single reusable workflow per program/action key. CUSTOM keys support
/// future modules without another schema migration.
model ApprovalWorkflow {
  id                 String                     @id @default(cuid())
  programId          String
  actionKey          String
  name               String
  description        String?
  priority           Int                        @default(0)
  scope              Json                       @default("{}")
  selfApprovalPolicy WorkflowSelfApprovalPolicy @default(DENY)
  isActive           Boolean                    @default(false)
  createdById        String?
  updatedById        String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  program  Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  steps    ApprovalWorkflowStep[]
  requests ApprovalRequest[]

  @@index([programId, actionKey, isActive, priority])
  @@index([programId, isActive])
}

model ApprovalWorkflowStep {
  id                    String               @id @default(cuid())
  workflowId            String
  stepOrder             Int
  name                  String
  approvalMode          WorkflowApprovalMode @default(ANY)
  requiredApprovalCount Int                  @default(1)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  workflow  ApprovalWorkflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignees ApprovalWorkflowAssignee[]

  @@unique([workflowId, stepOrder])
  @@index([workflowId, stepOrder])
}

model ApprovalWorkflowAssignee {
  id          String     @id @default(cuid())
  stepId      String
  adminUserId String?
  role        AdminRole?
  createdAt   DateTime   @default(now())

  step      ApprovalWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  adminUser AdminUser?           @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@unique([stepId, adminUserId])
  @@unique([stepId, role])
  @@index([adminUserId])
}

/// Runtime request. The request and child steps contain snapshots so edits to
/// the workflow definition never rewrite an in-flight or historical decision.
model ApprovalRequest {
  id                String                @id @default(cuid())
  programId         String
  workflowId        String
  actionKey         String
  status            ApprovalRequestStatus @default(PENDING)
  requestedByType   String
  requestedById     String
  requesterAdminId  String?
  subjectType       String
  subjectId         String
  payload           Json                  @default("{}")
  scopeSnapshot     Json                  @default("{}")
  workflowSnapshot  Json                  @default("{}")
  currentStepOrder  Int?
  idempotencyKey    String?
  requestedAt       DateTime              @default(now())
  resolvedAt        DateTime?
  resolvedBy        String?
  resolutionComment String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  program          Program               @relation(fields: [programId], references: [id], onDelete: Restrict)
  workflow         ApprovalWorkflow      @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  steps            ApprovalRequestStep[]
  decisions        ApprovalDecision[]
  pointExchange    PointExchangeRequest?
  rewardRedemption RewardRedemption?

  @@unique([programId, actionKey, idempotencyKey])
  @@index([programId, status, requestedAt])
  @@index([programId, actionKey, subjectType, subjectId])
  @@index([requesterAdminId])
}

model ApprovalRequestStep {
  id                    String                    @id @default(cuid())
  approvalRequestId     String
  stepOrder             Int
  name                  String
  approvalMode          WorkflowApprovalMode      @default(ANY)
  requiredApprovalCount Int                       @default(1)
  assigneesSnapshot     Json                      @default("[]")
  status                ApprovalRequestStepStatus @default(WAITING)
  openedAt              DateTime?
  completedAt           DateTime?
  createdAt             DateTime                  @default(now())

  approvalRequest ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  decisions       ApprovalDecision[]

  @@unique([approvalRequestId, stepOrder])
  @@index([approvalRequestId, status])
}

/// Immutable actor decision. No updatedAt is intentional.
model ApprovalDecision {
  id                String               @id @default(cuid())
  programId         String
  approvalRequestId String
  stepId            String
  approverAdminId   String
  decision          ApprovalDecisionType
  comment           String?
  createdAt         DateTime             @default(now())

  program         Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  approvalRequest ApprovalRequest     @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  step            ApprovalRequestStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  approver        AdminUser           @relation(fields: [approverAdminId], references: [id], onDelete: Restrict)

  @@unique([stepId, approverAdminId])
  @@index([programId, approverAdminId, createdAt])
  @@index([approvalRequestId, createdAt])
}

/// Capability overrides keep role names understandable while allowing each
/// program to tune what Owner, Operator and Auditor may actually do.
model AdminRolePermission {
  id          String    @id @default(cuid())
  programId   String
  role        AdminRole
  capability  String
  allowed     Boolean   @default(false)
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, role, capability])
  @@index([programId, role])
}

