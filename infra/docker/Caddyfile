# Default is plain HTTP on :80. Set CADDY_SITE_ADDRESS to a domain to enable
# Caddy's automatic HTTPS (keep HTTPS_PORT published in compose).
{$CADDY_SITE_ADDRESS} {
	encode gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:3002
	}

	handle /healthz {
		reverse_proxy api:3002
	}

	@adminRoot path /admin
	redir @adminRoot /admin/ 308

	handle_path /admin/* {
		reverse_proxy admin:80
	}

	@customerRoot path /customer
	redir @customerRoot /customer/ 308

	handle_path /customer/* {
		reverse_proxy portal:80
	}

	@adminDomainRoot {
		host adminloyalty.trunglocxoay.store
		path /
	}
	redir @adminDomainRoot /admin/ 302

	@customerRootPath path /
	redir @customerRootPath /customer/ 302

	# Unknown paths on the admin hostname return to Admin; other hostnames
	# return to the customer entry point.
	@adminDomain host adminloyalty.trunglocxoay.store
	handle @adminDomain {
		redir /admin/ 302
	}

	handle {
		redir /customer/ 302
	}
}
