generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Program {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  pointsUnit              String   @default("PTS")
  creditGivingLimit       Int?
  creditGivingPeriodDays  Int      @default(30)
  creditGivingPairLimit   Int?
  creditBankCycleDays     Int      @default(30)
  creditExpiryWarningDays Int[]    @default([30, 7])
  logoUrl                 String?
  isActive                Boolean  @default(true)
  defaultLocale           String   @default("es-MX")
  supportedLocales        String[] @default(["es-MX", "en-US"])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  members                       Member[]
  pointAccounts                 PointAccount[]
  pointRules                    PointRule[]
  creditWallets                 CreditWallet[]
  creditLots                    CreditLot[]
  creditTransactions            CreditTransaction[]
  creditBanks                   CreditBank[]
  creditBankTransactions        CreditBankTransaction[]
  creditExchangeRates           CreditExchangeRate[]
  creditExchangeRequests        CreditExchangeRequest[]
  creditSettings                CreditSetting[]
  creditSettingPermissions      CreditSettingPermission[]
  pointTypeDefinitions          PointTypeDefinition[]
  pointWallets                  CustomPointWallet[]
  pointTransactions             CustomPointTransaction[]
  pointLots                     CustomPointLot[]
  pointTransferRules            PointTransferRule[]             @relation("PointTransferRuleProgram")
  pointAllowances               PointAllowance[]
  pointBanks                    PointBank[]
  pointBankTransactions         PointBankTransaction[]
  pointBankCycles               PointBankCycle[]
  pointExchangeRates            PointExchangeRate[]
  pointExchangeRequests         PointExchangeRequest[]
  rewardPointPrices             RewardPointPrice[]
  adminRolePermissions          AdminRolePermission[]
  creditCategories              CreditCategory[]
  creditBankCycles              CreditBankCycle[]
  creditBulkBatches             CreditBulkBatch[]
  tiers                         Tier[]
  campaigns                     Campaign[]
  segments                      Segment[]
  coupons                       Coupon[]
  rewards                       Reward[]
  badges                        Badge[]
  notificationTemplates         NotificationTemplate[]
  memberDevices                 MemberDevice[]
  memberNotificationPreferences MemberNotificationPreferences[]
  coalitionAccounts             CoalitionAccount[]
  coalitionConfig               CoalitionConfig?
  adminUsers                    AdminUser[]
  approvalWorkflows             ApprovalWorkflow[]
  approvalRequests              ApprovalRequest[]
  approvalDecisions             ApprovalDecision[]
  events                        Event[]
  apiKeys                       ApiKey[]
  webhookSubscriptions          WebhookSubscription[]
  auditLogs                     AuditLog[]
  termsTemplates                TermsTemplate[]
  giftCardBatches               GiftCardBatch[]

  @@index([isActive])
}

model Member {
  id            String       @id @default(cuid())
  programId     String
  externalId    String?
  email         String?
  phone         String?
  firstName     String?
  lastName      String?
  department    String?
  photoUrl      String?
  metadata      Json?        @default("{}")
  tags          String[]     @default([])
  joinedAt      DateTime     @default(now())
  lastActiveAt  DateTime?
  deletedAt     DateTime?
  status        MemberStatus @default(ACTIVE)
  deactivatedAt DateTime?
  locale        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  program                        Program                         @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointAccount                   PointAccount?
  creditWallets                  CreditWallet[]
  creditTransactions             CreditTransaction[]             @relation("CreditTransactionMember")
  creditCounterpartyTransactions CreditTransaction[]             @relation("CreditTransactionCounterparty")
  creditLots                     CreditLot[]
  memberTiers                    MemberTier[]
  couponRedemptions              CouponRedemption[]
  rewardRedemptions              RewardRedemption[]
  memberBadges                   MemberBadge[]
  notifications                  Notification[]
  memberDevices                  MemberDevice[]
  memberNotificationPreferences  MemberNotificationPreferences[]
  coalitionAccounts              CoalitionAccount[]
  // Inbound events
  events                         Event[]
  sessions                       Session[]
  magicLinkTokens                MagicLinkToken[]
  giftCardTransactions           GiftCardTransaction[]
  exchangeRequests               CreditExchangeRequest[]
  pointWallets                   CustomPointWallet[]
  pointTransactions              CustomPointTransaction[]        @relation("PointTransactionMember")
  pointCounterpartyTransactions  CustomPointTransaction[]        @relation("PointTransactionCounterparty")
  pointLots                      CustomPointLot[]
  pointAllowances                PointAllowance[]
  pointExchangeRequests          PointExchangeRequest[]

  @@unique([programId, externalId])
  @@index([programId])
  @@index([email])
  @@index([deletedAt])
}

model PointAccount {
  id             String   @id @default(cuid())
  memberId       String   @unique
  programId      String
  balance        Int      @default(0)
  pendingBalance Int      @default(0)
  totalEarned    Int      @default(0)
  totalRedeemed  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member       Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program      Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  transactions PointTransaction[]

  @@index([memberId, programId])
  @@index([programId])
}

/// Canonical wallet definition. Codes such as P and R are optional template data,
/// never special cases in the schema or runtime.
model PointTypeDefinition {
  id                    String    @id @default(cuid())
  programId             String
  code                  String
  name                  String
  unitLabel             String    @default("points")
  description           String?
  icon                  String?
  color                 String?
  expiryMode            String    @default("NEVER")
  expiryDays            Int?
  fixedExpiryAt         DateTime?
  expiryWarningDays     Int[]     @default([30, 7])
  allowNegativeBalance  Boolean   @default(false)
  allowManualAdjustment Boolean   @default(true)
  transferable          Boolean   @default(false)
  redeemable            Boolean   @default(false)
  exchangeable          Boolean   @default(false)
  cashEligible          Boolean   @default(false)
  bankEnabled           Boolean   @default(false)
  giveEnabled           Boolean   @default(false)
  giveSource            String    @default("BALANCE")
  allowanceAmount       Int?
  allowanceCycleDays    Int       @default(30)
  allowanceCarryOver    Boolean   @default(false)
  pairLimit             Int?
  pairLimitPeriodDays   Int       @default(30)
  requireGiveMessage    Boolean   @default(true)
  allowMultiRecipient   Boolean   @default(true)
  maxRecipients         Int       @default(500)
  showOnMemberProfile   Boolean   @default(true)
  showZeroBalance       Boolean   @default(true)
  isPrimary             Boolean   @default(false)
  sortOrder             Int       @default(0)
  isActive              Boolean   @default(true)
  archivedAt            DateTime?
  metadata              Json?     @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  program                 Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  wallets                 CustomPointWallet[]
  transactions            CustomPointTransaction[]
  sourceTransactions      CustomPointTransaction[] @relation("PointTransactionSourceType")
  destinationTransactions CustomPointTransaction[] @relation("PointTransactionDestinationType")
  lots                    CustomPointLot[]
  outgoingTransferRules   PointTransferRule[]      @relation("PointTransferSource")
  incomingTransferRules   PointTransferRule[]      @relation("PointTransferDestination")
  allowances              PointAllowance[]
  banks                   PointBank[]
  bankTransactions        PointBankTransaction[]
  bankCycles              PointBankCycle[]
  exchangeRates           PointExchangeRate[]
  exchangeRequests        PointExchangeRequest[]
  rewardPrices            RewardPointPrice[]
  rewardRedemptions       RewardRedemption[]
  pointRules              PointRule[]
  campaigns               Campaign[]
  tiers                   Tier[]

  @@unique([programId, code])
  @@index([programId, isActive])
}

model CustomPointWallet {
  id          String   @id @default(cuid())
  memberId    String
  programId   String
  pointTypeId String
  balance     Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member       Member                   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program      Program                  @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointType    PointTypeDefinition      @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)
  transactions CustomPointTransaction[]
  lots         CustomPointLot[]

  @@unique([memberId, pointTypeId])
  @@index([programId, pointTypeId])
}

model CustomPointTransaction {
  id                     String    @id @default(cuid())
  walletId               String
  memberId               String
  programId              String
  pointTypeId            String
  action                 String
  amount                 Int
  balanceAfter           Int
  source                 String    @default("manual")
  reason                 String?
  message                String?
  category               String?
  categoryId             String?
  counterpartyMemberId   String?
  sourcePointTypeId      String?
  destinationPointTypeId String?
  exchangeRateId         String?
  exchangeRequestId      String?   @unique
  actorType              String?
  actorId                String?
  previousHash           String?
  recordHash             String?
  reversedFromId         String?
  reversedById           String?
  idempotencyKey         String
  expiresAt              DateTime?
  metadata               Json?     @default("{}")
  createdAt              DateTime  @default(now())

  wallet               CustomPointWallet     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  member               Member                @relation("PointTransactionMember", fields: [memberId], references: [id], onDelete: Restrict)
  counterparty         Member?               @relation("PointTransactionCounterparty", fields: [counterpartyMemberId], references: [id], onDelete: SetNull)
  program              Program               @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointType            PointTypeDefinition   @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)
  sourcePointType      PointTypeDefinition?  @relation("PointTransactionSourceType", fields: [sourcePointTypeId], references: [id], onDelete: SetNull)
  destinationPointType PointTypeDefinition?  @relation("PointTransactionDestinationType", fields: [destinationPointTypeId], references: [id], onDelete: SetNull)
  categoryRef          CreditCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exchangeRate         PointExchangeRate?    @relation(fields: [exchangeRateId], references: [id], onDelete: SetNull)
  exchangeRequest      PointExchangeRequest? @relation(fields: [exchangeRequestId], references: [id], onDelete: SetNull)
  grantLots            CustomPointLot[]

  @@unique([programId, idempotencyKey])
  @@index([memberId, pointTypeId, createdAt])
  @@index([programId, pointTypeId, createdAt])
  @@index([categoryId])
  @@index([counterpartyMemberId])
  @@index([recordHash])
  @@index([expiresAt])
}

model CustomPointLot {
  id                 String    @id @default(cuid())
  walletId           String
  memberId           String
  programId          String
  pointTypeId        String
  grantTransactionId String
  originalAmount     Int
  remainingAmount    Int
  expiresAt          DateTime?
  warningDaysSent    Int[]     @default([])
  createdAt          DateTime  @default(now())

  wallet           CustomPointWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  member           Member                 @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program          Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointType        PointTypeDefinition    @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)
  grantTransaction CustomPointTransaction @relation(fields: [grantTransactionId], references: [id], onDelete: Restrict)

  @@index([grantTransactionId])
  @@index([memberId, pointTypeId, remainingAmount, expiresAt])
}

/// Explicit source -> destination matrix for Give/transfer. A missing row means
/// the transfer is forbidden.
model PointTransferRule {
  id                     String   @id @default(cuid())
  programId              String
  sourcePointTypeId      String
  destinationPointTypeId String
  sourceAmount           Int      @default(1)
  destinationAmount      Int      @default(1)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  program         Program             @relation("PointTransferRuleProgram", fields: [programId], references: [id], onDelete: Cascade)
  sourceType      PointTypeDefinition @relation("PointTransferSource", fields: [sourcePointTypeId], references: [id], onDelete: Cascade)
  destinationType PointTypeDefinition @relation("PointTransferDestination", fields: [destinationPointTypeId], references: [id], onDelete: Cascade)

  @@unique([sourcePointTypeId, destinationPointTypeId])
  @@index([programId, isActive])
}

/// A Give allowance is deliberately separate from a member's owned wallet.
model PointAllowance {
  id          String   @id @default(cuid())
  memberId    String
  programId   String
  pointTypeId String
  cycleStart  DateTime
  cycleEnd    DateTime
  allocated   Int
  remaining   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member    Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program   Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointType PointTypeDefinition @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)

  @@unique([memberId, pointTypeId, cycleStart])
  @@index([programId, pointTypeId, cycleEnd])
}

model PointBank {
  id          String   @id @default(cuid())
  programId   String
  pointTypeId String
  balance     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program      Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointType    PointTypeDefinition    @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)
  transactions PointBankTransaction[]

  @@unique([programId, pointTypeId])
  @@index([programId])
}

model PointBankTransaction {
  id             String   @id @default(cuid())
  bankId         String
  programId      String
  pointTypeId    String
  amount         Int
  balanceAfter   Int
  type           String
  reason         String
  actorId        String
  cycleId        String?
  idempotencyKey String
  createdAt      DateTime @default(now())

  bank      PointBank           @relation(fields: [bankId], references: [id], onDelete: Restrict)
  program   Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointType PointTypeDefinition @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)
  cycle     PointBankCycle?     @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@unique([programId, idempotencyKey])
  @@index([programId, pointTypeId, createdAt])
}

model PointBankCycle {
  id          String    @id @default(cuid())
  programId   String
  pointTypeId String
  startsAt    DateTime
  endsAt      DateTime
  status      String    @default("OPEN")
  opening     Int       @default(0)
  allocated   Int       @default(0)
  closing     Int       @default(0)
  clearedAt   DateTime?
  clearedBy   String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  program      Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointType    PointTypeDefinition    @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)
  transactions PointBankTransaction[]

  @@index([programId, pointTypeId, status])
  @@index([programId, startsAt, endsAt])
}

model PointExchangeRate {
  id                 String   @id @default(cuid())
  programId          String
  pointTypeId        String
  version            Int
  valueMinorPerPoint Int
  currency           String   @db.Char(3)
  payoutMechanism    String
  payoutType         String   @default("NON_CASH")
  minPoints          Int      @default(1)
  maxPoints          Int?
  periodLimitPoints  Int?
  periodDays         Int      @default(30)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  program      Program                  @relation(fields: [programId], references: [id], onDelete: Restrict)
  pointType    PointTypeDefinition      @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)
  transactions CustomPointTransaction[]
  requests     PointExchangeRequest[]

  @@unique([programId, pointTypeId, version])
  @@index([programId, pointTypeId, isActive])
}

enum PointExchangeStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
  REJECTED
}

model PointExchangeRequest {
  id                  String              @id @default(cuid())
  programId           String
  documentNumber      String
  memberId            String
  pointTypeId         String
  amount              Int
  valueMinor          Int
  currency            String              @db.Char(3)
  payoutMechanism     String
  payoutType          String
  status              PointExchangeStatus @default(PENDING)
  exchangeRateId      String
  idempotencyKey      String
  requestedAt         DateTime            @default(now())
  approvedAt          DateTime?
  approvedBy          String?
  approvalNote        String?
  completedAt         DateTime?
  completedBy         String?
  completionReference String?
  completionNote      String?
  cancelledAt         DateTime?
  cancelledBy         String?
  cancellationReason  String?
  approvalRequestId   String?             @unique
  metadata            Json?               @default("{}")

  program         Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  member          Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  pointType       PointTypeDefinition     @relation(fields: [pointTypeId], references: [id], onDelete: Restrict)
  exchangeRate    PointExchangeRate       @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  transaction     CustomPointTransaction?
  approvalRequest ApprovalRequest?        @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@unique([programId, idempotencyKey])
  @@unique([programId, documentNumber])
  @@index([programId, status, requestedAt])
  @@index([memberId, requestedAt])
}

enum TransactionType {
  EARN
  REDEEM
  EXPIRE
  REVERSE
  ADJUST
  CONVERT_OUT
  CONVERT_IN
}

model PointTransaction {
  id             String          @id @default(cuid())
  accountId      String
  type           TransactionType
  amount         Int
  balanceAfter   Int
  source         String
  description    String?
  metadata       Json?           @default("{}")
  idempotencyKey String          @unique
  expiresAt      DateTime?
  settledAt      DateTime?
  reversedFromId String?
  reversedById   String?
  createdAt      DateTime        @default(now())

  account PointAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([type])
  @@index([idempotencyKey])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([source])
}

enum CreditType {
  P
  R
}

enum CreditTransactionType {
  GRANT
  GIVE_OUT
  GIVE_IN
  REDEEM
  EXCHANGE
  ADJUSTMENT
  EXPIRATION
  REVERSAL
  CLEARANCE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum CreditExchangeStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
  REJECTED
}

enum CreditBankCycleStatus {
  OPEN
  CLOSED
  CLEARED
}

enum CreditBulkStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum RewardFulfillmentStatus {
  PENDING
  FULFILLED
  CANCELLED
}

/// The two program wallets required by the Credit & Recognition rule book.
/// This ledger is append-only: balance changes are represented by signed rows.
model CreditWallet {
  id           String     @id @default(cuid())
  memberId     String
  programId    String
  creditType   CreditType
  balance      Int        @default(0)
  totalGranted Int        @default(0)
  totalSpent   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  member       Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program      Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  transactions CreditTransaction[]
  lots         CreditLot[]

  @@unique([memberId, creditType])
  @@index([programId, creditType])
  @@index([memberId, programId])
}

model CreditTransaction {
  id                   String                @id @default(cuid())
  walletId             String
  memberId             String
  programId            String
  creditType           CreditType
  type                 CreditTransactionType
  amount               Int
  balanceAfter         Int
  source               String
  reason               String?
  message              String?
  category             String?
  categoryId           String?
  sourceCreditType     CreditType?
  receivedCreditType   CreditType?
  counterpartyMemberId String?
  idempotencyKey       String                @unique
  expiresAt            DateTime?
  exchangeRateId       String?
  exchangeRequestId    String?               @unique
  actorType            String?
  actorId              String?
  previousHash         String?
  recordHash           String?
  metadata             Json?                 @default("{}")
  createdAt            DateTime              @default(now())

  wallet          CreditWallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  member          Member                 @relation("CreditTransactionMember", fields: [memberId], references: [id], onDelete: Restrict)
  program         Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  counterparty    Member?                @relation("CreditTransactionCounterparty", fields: [counterpartyMemberId], references: [id], onDelete: SetNull)
  exchangeRate    CreditExchangeRate?    @relation(fields: [exchangeRateId], references: [id], onDelete: SetNull)
  exchangeRequest CreditExchangeRequest? @relation(fields: [exchangeRequestId], references: [id], onDelete: SetNull)
  categoryRef     CreditCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  grantLot        CreditLot?

  @@index([memberId, createdAt])
  @@index([programId, creditType, createdAt])
  @@index([walletId, createdAt])
  @@index([type])
  @@index([expiresAt])
}

/// Mutable allocation state for an immutable positive ledger grant.
/// Debits consume lots FIFO; expiration only removes the remaining amount in an expired lot.
model CreditLot {
  id                 String     @id @default(cuid())
  grantTransactionId String     @unique
  walletId           String
  memberId           String
  programId          String
  creditType         CreditType
  originalAmount     Int
  remainingAmount    Int
  expiresAt          DateTime?
  warningDaysSent    Int[]      @default([])
  createdAt          DateTime   @default(now())

  grantTransaction CreditTransaction @relation(fields: [grantTransactionId], references: [id], onDelete: Restrict)
  wallet           CreditWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  member           Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program          Program           @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([walletId, remainingAmount, expiresAt])
  @@index([memberId, creditType, expiresAt])
}

model CreditBank {
  id         String     @id @default(cuid())
  programId  String
  creditType CreditType
  balance    Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  program      Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  transactions CreditBankTransaction[]

  @@unique([programId, creditType])
  @@index([programId])
}

model CreditCategory {
  id          String   @id @default(cuid())
  programId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program           Program                  @relation(fields: [programId], references: [id], onDelete: Restrict)
  transactions      CreditTransaction[]
  pointTransactions CustomPointTransaction[]

  @@unique([programId, name])
  @@index([programId, isActive])
}

model CreditBankTransaction {
  id             String     @id @default(cuid())
  bankId         String
  programId      String
  creditType     CreditType
  amount         Int
  balanceAfter   Int
  type           String
  reason         String
  actorId        String
  cycleId        String?
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  bank    CreditBank       @relation(fields: [bankId], references: [id], onDelete: Restrict)
  program Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  cycle   CreditBankCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([programId, creditType, createdAt])
}

model CreditBankCycle {
  id         String                @id @default(cuid())
  programId  String
  startsAt   DateTime
  endsAt     DateTime
  status     CreditBankCycleStatus @default(OPEN)
  openingP   Int                   @default(0)
  openingR   Int                   @default(0)
  allocatedP Int                   @default(0)
  allocatedR Int                   @default(0)
  closingP   Int                   @default(0)
  closingR   Int                   @default(0)
  clearedAt  DateTime?
  clearedBy  String?
  note       String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  program      Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  transactions CreditBankTransaction[]

  @@index([programId, status])
  @@index([programId, startsAt, endsAt])
}

model CreditExchangeRate {
  id                  String     @id @default(cuid())
  programId           String
  creditType          CreditType
  version             Int
  valueMinorPerCredit Int
  currency            String     @db.Char(3)
  payoutMechanism     String
  cashEligible        Boolean    @default(false)
  minCredits          Int        @default(1)
  maxCredits          Int?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())

  program      Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  transactions CreditTransaction[]
  requests     CreditExchangeRequest[]

  @@unique([programId, creditType, version])
  @@index([programId, creditType, isActive])
}

model CreditSetting {
  id          String   @id @default(cuid())
  programId   String
  key         String
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

