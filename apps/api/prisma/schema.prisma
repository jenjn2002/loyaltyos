}

model ApiKey {
  id         String    @id @default(cuid())
  programId  String
  key        String    @unique
  scope      String    @default("SERVER") // SERVER or CLIENT
  name       String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([programId])
}

enum AuditAction {
  ADJUST_POINTS
  REVERSE_TRANSACTION
  CREATE_COUPON
  DELETE_COUPON
  UPDATE_CAMPAIGN
  UPDATE_REWARD
  MERGE_MEMBERS
  MANUAL_TIER_CHANGE
  CONFIG_CHANGE
  OTHER
  CREATE_NOTIFICATION_TEMPLATE
  UPDATE_NOTIFICATION_TEMPLATE
  DELETE_NOTIFICATION_TEMPLATE
  CREATE_WEBHOOK
  UPDATE_WEBHOOK
  DELETE_WEBHOOK
  SEND_TEST_NOTIFICATION
  PREVIEW_NOTIFICATION_TEMPLATE
  CREDIT_GIVE
  CREDIT_REDEEM
  CREDIT_EXCHANGE
  CREDIT_ADJUSTMENT
  CREDIT_BULK
  CREDIT_BANK
  CREDIT_CLEARANCE
}

enum AuditActorType {
  ADMIN_USER
  API_KEY
  MEMBER
  SYSTEM
}

model AuditLog {
  id          String         @id @default(cuid())
  programId   String
  adminUserId String?
  actorType   AuditActorType @default(API_KEY)
  actorId     String         @default("legacy-unknown")
  action      AuditAction
  entityType  String
  entityId    String?
  diff        Json?          @default("{}")
  reason      String?
  ipAddress   String?
  createdAt   DateTime       @default(now())

  program   Program    @relation(fields: [programId], references: [id], onDelete: Restrict)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([adminUserId])
  @@index([actorType, actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model MemberDevice {
  id         String         @id @default(cuid())
  memberId   String
  programId  String
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([memberId, programId])
}

model MemberNotificationPreferences {
  id        String              @id @default(cuid())
  memberId  String
  programId String
  channel   NotificationChannel
  optedIn   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([memberId, programId, channel])
}

model Event {
  id             String    @id @default(cuid())
  programId      String
  memberId       String?
  type           String
  payload        Json?     @default("{}")
  idempotencyKey String
  processed      Boolean   @default(false)
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([programId, idempotencyKey])
  @@index([programId, type])
  @@index([processed])
  @@index([createdAt])
}
