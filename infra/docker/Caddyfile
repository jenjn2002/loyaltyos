# Default is plain HTTP on :80. Set CADDY_SITE_ADDRESS to a domain to enable
# Caddy's automatic HTTPS (keep HTTPS_PORT published in compose).
{$CADDY_SITE_ADDRESS} {
	encode gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:3002
	}

	handle /healthz {
		reverse_proxy api:3002
	}

	@adminRoot path /admin
	redir @adminRoot /admin/ 308

	handle_path /admin/* {
		reverse_proxy admin:80
	}

	@customerRoot path /customer
	redir @customerRoot /customer/ 308

	handle_path /customer/* {
		reverse_proxy portal:80
	}

	@root path /
	redir @root /customer/ 302

	# Unknown paths are sent to the customer entry point.
	handle {
		redir /customer/ 302
	}
}
