# Production-data sandbox environment template.
# Copy to infra/docker/.env.staging, chmod 600, then replace every placeholder.
# Never commit infra/docker/.env.staging or paste its contents in issue reports.

# Keep these names unless you also update the documented restore commands.
POSTGRES_USER=loyaltyos
POSTGRES_PASSWORD=replace-me-with-a-random-sandbox-database-password
POSTGRES_DB=loyaltyos_staging

# Bootstrap-only values for an empty sandbox database. A production restore
# copies the existing production accounts and does not replace their passwords.
ADMIN_DEFAULT_EMAIL=sandbox-admin@example.invalid
ADMIN_DEFAULT_NAME=Sandbox Bootstrap Admin
ADMIN_DEFAULT_PASSWORD=replace-me-with-a-strong-sandbox-password

# Generate fresh values with: openssl rand -hex 64 / openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-64
API_KEY_SALT=replace-me-with-a-random-sandbox-secret
KMS_MASTER_KEY=replace-me-with-a-random-sandbox-secret
GIFTCARD_HMAC_SECRET=replace-me-with-a-random-sandbox-secret

# Must exactly match ENV_HANDOFF_SECRET in infra/docker/.env.production.
ENV_HANDOFF_SECRET=copy-the-production-value-here
